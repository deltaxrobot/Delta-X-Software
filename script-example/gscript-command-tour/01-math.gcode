; SOFTWARE ONLY. Trigonometric angles are in degrees.
#Examples.MathPassed = 0
#Examples.Value = #sin(90)
M98 Passert(#abs(#Examples.Value - 1) < 0.001, "sin(90) result")
#Examples.Value = #cos(0)
M98 Passert(#abs(#Examples.Value - 1) < 0.001, "cos(0) result")
#Examples.Value = #tan(45)
M98 Passert(#abs(#Examples.Value - 1) < 0.001, "tan(45) result")
#Examples.Value = #atan(1)
M98 Passert(#abs(#Examples.Value - 45) < 0.001, "atan(1) result")
#Examples.Value = #atan2(1,1)
M98 Passert(#abs(#Examples.Value - 45) < 0.001, "atan2(1,1) result")
#Examples.Value = #sqrt(81)
M98 Passert(#abs(#Examples.Value - 9) < 0.001, "sqrt(81) result")
#Examples.Value = #abs(-4)
M98 Passert(#abs(#Examples.Value - 4) < 0.001, "abs(-4) result")
#Examples.Value = #round(2.6)
M98 Passert(#abs(#Examples.Value - 3) < 0.001, "round(2.6) result")
#Examples.Value = #floor(2.6)
M98 Passert(#abs(#Examples.Value - 2) < 0.001, "floor(2.6) result")
#Examples.Value = #ceil(2.2)
M98 Passert(#abs(#Examples.Value - 3) < 0.001, "ceil(2.2) result")
#Examples.Value = #min(3,7)
M98 Passert(#abs(#Examples.Value - 3) < 0.001, "min(3,7) result")
#Examples.Value = #max(3,7)
M98 Passert(#abs(#Examples.Value - 7) < 0.001, "max(3,7) result")
#Examples.Value = #pow(2,3)
M98 Passert(#abs(#Examples.Value - 8) < 0.001, "pow(2,3) result")
#Examples.Value = #log(1)
M98 Passert(#abs(#Examples.Value - 0) < 0.001, "log(1) result")
#Examples.Value = #log10(100)
M98 Passert(#abs(#Examples.Value - 2) < 0.001, "log10(100) result")
#Examples.Value = #exp(0)
M98 Passert(#abs(#Examples.Value - 1) < 0.001, "exp(0) result")
#Examples.MathPassed = 1
M98 PlogMessage("PASS math")
